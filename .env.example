# 이 파일을 .env로 복사한 뒤 값을 채워 주세요.
DISCORD_TOKEN=
GUILD_ID=
# 선택: 자동 알림 기본 채널 ID (/공모전설정, /식단설정으로 지정하면 그 채널이 우선)
CHANNEL_ID=

# 선택: DB 파일 위치 (기본값: bot.py 옆의 contest.db)
# DB_PATH=/home/ubuntu/contest_alert/contest.db

# 기상청 단기예보 공공데이터포털 일반 인증키(Decoding) — /가상날씨에 필요
# ⚠️ 우산 알람 보드의 python/config.json "api_key"와 **같은 값**을 넣어야
#    봇과 기기가 같은 날씨를 말한다.
KMA_API_KEY=
# 기상청 격자 좌표 — 보드 config.json의 grid_nx / grid_ny와 같은 값
# (비우면 서울 동작구 기준 59 / 126)
KMA_NX=59
KMA_NY=126
